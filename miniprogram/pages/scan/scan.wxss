/* ============================================================
 * Scan Page — Material 3 + Tech Aesthetic
 * ============================================================ */

.container {
  padding: var(--page-padding);
  padding-top: 20rpx;
  min-height: 100vh;
}

/* ── Status Banner ── */
.status-banner {
  display: flex;
  align-items: center;
  background: var(--surface-1);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: var(--card-gap);
  box-shadow: var(--elevation-2);
  border: 1rpx solid var(--outline-variant);
  transition: all var(--duration-medium) var(--ease-standard);
}

.status-banner.connected {
  background: var(--primary-container);
  border-color: var(--primary-light);
}

.status-indicator {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: var(--radius-full);
  background: var(--outline);
  transition: all var(--duration-long) var(--ease-emphasized);
  z-index: 2;
}

.connected .status-dot {
  background: var(--tertiary);
  box-shadow: 0 0 16rpx rgba(30,142,62,0.4);
}

/* Ripple animation when connected */
.status-ripple {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--tertiary);
  opacity: 0;
  animation: ripple 2s ease-out infinite;
}

@keyframes ripple {
  0%   { transform: scale(0.8); opacity: 0.6; }
  100% { transform: scale(1.8); opacity: 0; }
}

.status-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.status-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  letter-spacing: var(--ls-tight);
}

.status-sub {
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* ── Action card (below status) ── */
.action-card {
  display: flex;
  align-items: center;
  background: var(--primary);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: var(--card-gap);
  box-shadow: var(--elevation-2);
  transition: all var(--duration-short) var(--ease-standard);
}

.action-card-pressed {
  transform: scale(0.985);
  box-shadow: var(--elevation-1);
  opacity: 0.95;
}

.action-card-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.action-card-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--on-primary);
  letter-spacing: var(--ls-tight);
}

.action-card-desc {
  font-size: var(--fs-label);
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.action-card-arrow {
  font-size: 36rpx;
  color: var(--on-primary);
  flex-shrink: 0;
  margin-left: 20rpx;
  font-weight: var(--fw-semibold);
}

/* ── Scan Panel ── */
.scan-panel {
  background: var(--surface-1);
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
  box-shadow: var(--elevation-1);
  border: 1rpx solid var(--outline-variant);
}

.panel-header {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.panel-title {
  font-size: var(--fs-headline);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  letter-spacing: var(--ls-tight);
}

.panel-badge {
  background: var(--primary-container);
  min-width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 0 12rpx;
}

.badge-text {
  font-size: var(--fs-label);
  font-weight: var(--fw-semibold);
  color: var(--primary);
}

.panel-desc {
  font-size: var(--fs-body-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

/* ── Device Card List ── */
.device-list {
  margin-top: 16rpx;
}

.device-card {
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid transparent;
  transition: all var(--duration-short) var(--ease-standard);
}

.device-card:last-child {
  margin-bottom: 0;
}

.device-card:active {
  background: var(--primary-container);
  border-color: var(--primary-light);
  transform: scale(0.985);
}

.device-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-full);
  background: var(--surface-1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--outline-variant);
}

.device-avatar-text {
  font-size: var(--fs-label);
  font-weight: var(--fw-bold);
  color: var(--primary);
  letter-spacing: 0.5rpx;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.device-name {
  font-size: var(--fs-body);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
}

.device-signal {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.signal-bars {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  margin-right: 12rpx;
  height: 24rpx;
}

.signal-bar {
  width: 6rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: var(--outline-variant);
  transition: background var(--duration-medium) var(--ease-standard);
}

.signal-bar.s1 { height: 8rpx; }
.signal-bar.s2 { height: 14rpx; }
.signal-bar.s3 { height: 20rpx; }
.signal-bar.s4 { height: 26rpx; }

.signal-bar.active {
  background: var(--primary);
}

.device-meta {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
}

.device-connect-text {
  font-size: var(--fs-label);
  font-weight: var(--fw-semibold);
  color: var(--primary);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ── Radar scanning animation ── */
.radar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0 40rpx;
}

.radar-scan {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-ring {
  position: absolute;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--primary);
  opacity: 0;
  animation: radar-pulse 2.4s ease-out infinite;
}

.radar-ring.r1 { width: 40rpx; height: 40rpx; animation-delay: 0s; }
.radar-ring.r2 { width: 80rpx; height: 80rpx; animation-delay: 0.8s; }
.radar-ring.r3 { width: 120rpx; height: 120rpx; animation-delay: 1.6s; }

@keyframes radar-pulse {
  0%   { opacity: 0.6; transform: scale(0.3); }
  100% { opacity: 0; transform: scale(1); }
}

.radar-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: var(--primary);
  box-shadow: 0 0 20rpx rgba(26,115,232,0.5);
  z-index: 2;
  animation: dot-blink 1.2s ease-in-out infinite;
}

@keyframes dot-blink {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50%      { transform: scale(1.3); opacity: 1; }
}

.radar-text {
  margin-top: 28rpx;
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-medium);
  color: var(--primary);
  letter-spacing: var(--ls-wide);
}

/* ── Empty state ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx 52rpx;
}

.empty-icon-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 2rpx dashed var(--outline);
}

.empty-icon-text {
  font-size: 48rpx;
}

.empty-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--fs-body-sm);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* ── FAB Primary Button ── */
.primary-fab {
  width: 100%;
  height: 104rpx;
  background: var(--primary);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--card-gap);
  box-shadow: var(--elevation-fab);
  border: none;
  padding: 0;
  line-height: 104rpx;
  transition: all var(--duration-short) var(--ease-standard);
}

.primary-fab[disabled] {
  background: var(--surface-variant);
  box-shadow: none;
  opacity: 1;
}

.primary-fab[disabled] .fab-label {
  color: var(--text-tertiary);
}

.primary-fab[disabled] .fab-icon {
  opacity: 0.5;
}

.fab-pressed {
  transform: scale(0.97);
  box-shadow: var(--elevation-1);
}

.fab-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.fab-icon {
  font-size: 36rpx;
  color: var(--on-primary);
}

.fab-label {
  font-size: var(--fs-title);
  font-weight: var(--fw-semibold);
  color: var(--on-primary);
  letter-spacing: var(--ls-wide);
}

/* ── Snackbar ── */
.snackbar {
  position: fixed;
  bottom: 56rpx;
  left: 32rpx;
  right: 32rpx;
  background: #2D2F31;
  color: #FFFFFF;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-body-sm);
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: var(--elevation-4);
  opacity: 0;
  transform: translateY(20rpx);
  pointer-events: none;
  transition: all var(--duration-medium) var(--ease-emphasized);
  z-index: 1000;
}

.snackbar-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.snackbar-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.snackbar-text {
  flex: 1;
  line-height: 1.5;
}
