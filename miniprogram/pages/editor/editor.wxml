<view class="container">
  <!-- Template selector — visual cards -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">模板样式</text>
      <text class="section-subtitle">选择座牌排版风格</text>
    </view>
    <scroll-view class="template-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
      <view class="template-card {{templateId === item.id ? 'template-card-active' : ''}}"
        wx:for="{{templates}}" wx:key="id"
        bindtap="onTemplateSelect" data-index="{{index}}">
        <!-- CSS mini-preview of template -->
        <view class="template-thumb {{item.id}}">
          <view class="thumb-line thumb-top" wx:if="{{item.id === 'classic' || item.id === 'minimal' || item.id === 'bold'}}"></view>
          <view class="thumb-line thumb-center {{item.id}}"></view>
          <view class="thumb-line thumb-bottom" wx:if="{{item.id === 'classic' || item.id === 'minimal' || item.id === 'bold'}}"></view>
          <view class="thumb-divider" wx:if="{{item.id === 'business'}}"></view>
        </view>
        <text class="template-name">{{item.name}}</text>
        <text class="template-desc">{{item.desc}}</text>
        <view class="template-check" wx:if="{{templateId === item.id}}">✓</view>
      </view>
    </scroll-view>
  </view>

  <!-- Display size -->
  <view class="section size-section">
    <view class="section-header">
      <text class="section-title">屏幕尺寸</text>
    </view>
    <view class="size-row">
      <view class="size-chip {{displayIndex === index ? 'size-chip-active' : ''}}"
        wx:for="{{displaySizes}}" wx:key="label"
        bindtap="onSizeChange" data-index="{{index}}">
        <text class="size-chip-label">{{item.label}}</text>
        <text class="size-chip-dims">{{item.width}}×{{item.height}}</text>
      </view>
    </view>
  </view>

  <!-- Compact content form — single row per field -->
  <view class="section section-compact">
    <view class="section-header section-header-compact">
      <text class="section-title">座牌内容</text>
    </view>

    <!-- Unit name -->
    <view class="field-row {{highlightField === 'top' ? 'field-row-hl' : ''}}">
      <text class="field-label">单位</text>
      <input class="field-input-compact" placeholder="如：西南大学" value="{{topText}}"
        bindinput="onTopInput" maxlength="30"
        placeholder-style="color: var(--text-tertiary);"/>
    </view>
    <view class="slider-row">
      <slider class="slider-compact" min="0.5" max="2.0" step="0.05"
        value="{{topScale}}" bindchange="onTopScaleChange"
        block-size="16" activeColor="#1A73E8" backgroundColor="#E8EAED"/>
      <text class="slider-val">{{Math.round(topScale * 100)}}%</text>
    </view>

    <!-- Center name -->
    <view class="field-row {{highlightField === 'center' ? 'field-row-hl' : ''}}">
      <text class="field-label">姓名</text>
      <input class="field-input-compact field-input-bold" placeholder="如：张三" value="{{centerText}}"
        bindinput="onCenterInput" maxlength="10"
        placeholder-style="color: var(--text-tertiary);"/>
    </view>
    <view class="slider-row">
      <slider class="slider-compact" min="0.5" max="2.0" step="0.05"
        value="{{centerScale}}" bindchange="onCenterScaleChange"
        block-size="16" activeColor="#1A73E8" backgroundColor="#E8EAED"/>
      <text class="slider-val">{{Math.round(centerScale * 100)}}%</text>
    </view>

    <!-- Title -->
    <view class="field-row {{highlightField === 'bottom' ? 'field-row-hl' : ''}}">
      <text class="field-label">职务</text>
      <input class="field-input-compact" placeholder="如：学生" value="{{bottomText}}"
        bindinput="onBottomInput" maxlength="20"
        placeholder-style="color: var(--text-tertiary);"/>
    </view>
    <view class="slider-row slider-row-last">
      <slider class="slider-compact" min="0.5" max="2.0" step="0.05"
        value="{{bottomScale}}" bindchange="onBottomScaleChange"
        block-size="16" activeColor="#1A73E8" backgroundColor="#E8EAED"/>
      <text class="slider-val">{{Math.round(bottomScale * 100)}}%</text>
    </view>
  </view>

  <!-- Preview -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">实时预览</text>
      <view class="preview-label">点击预览定位编辑 ↘</view>
    </view>
    <view class="preview-frame">
      <view class="preview-screen" style="aspect-ratio:{{epdWidth}}/{{epdHeight}}">
        <canvas type="2d" id="editCanvas" class="preview-canvas"></canvas>
        <!-- Transparent touch zones matching each template's layout -->
        <view class="touch-overlay" wx:if="{{templateId !== 'business'}}">
          <view class="touch-zone touch-top"
            style="height:{{templateId === 'classic' ? 14.28 : templateId === 'bold' ? 13 : 14}}%"
            bindtap="focusField" data-field="top"></view>
          <view class="touch-zone touch-center"
            style="height:{{templateId === 'classic' ? 71.44 : templateId === 'bold' ? 72 : 66}}%"
            bindtap="focusField" data-field="center"></view>
          <view class="touch-zone touch-bottom"
            style="height:{{templateId === 'classic' ? 14.28 : templateId === 'bold' ? 15 : 20}}%"
            bindtap="focusField" data-field="bottom"></view>
        </view>
        <!-- Business template: left/right split -->
        <view class="touch-overlay touch-horizontal" wx:else>
          <view class="touch-zone-h"
            style="width:44%"
            bindtap="focusField" data-field="center"></view>
          <view class="touch-zone-h"
            style="width:56%;display:flex;flex-direction:column">
            <view class="touch-zone"
              style="height:45%"
              bindtap="focusField" data-field="top"></view>
            <view class="touch-zone"
              style="height:55%"
              bindtap="focusField" data-field="bottom"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Send button -->
  <button class="send-button" bindtap="sendToDevice"
    disabled="{{sending || !bleReady}}"
    hover-class="send-button-pressed">
    <text class="send-text">{{sending ? '发送中 ' + progress + '%' : '发送到设备'}}</text>
  </button>

  <!-- Progress bar -->
  <view class="progress-wrap" wx:if="{{sending}}">
    <view class="progress-label">传输进度</view>
    <view class="progress-track">
      <view class="progress-fill" style="width:{{progress}}%"></view>
      <view class="progress-glow" style="left:{{progress}}%"></view>
    </view>
  </view>

  <!-- Status banner -->
  <view class="status-banner {{statusType}}" wx:if="{{statusMsg}}">
    <text class="status-icon">{{statusType === 'success' ? '✓' : statusType === 'error' ? '✕' : 'ℹ'}}</text>
    <text class="status-text">{{statusMsg}}</text>
  </view>

  <!-- Disconnect -->
  <view class="disconnect-btn" bindtap="goBack" hover-class="disconnect-btn-pressed">
    <text class="disconnect-text">断开连接</text>
  </view>

  <view class="safe-bottom"></view>
</view>
