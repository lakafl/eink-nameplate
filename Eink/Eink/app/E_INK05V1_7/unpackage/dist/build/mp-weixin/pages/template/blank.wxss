.page-container{height:100vh;display:flex;flex-direction:column;background-color:#f5f5f5}.top-section{height:15vh;background:linear-gradient(135deg,#87ceeb,#b0e0e6);border-radius:0 0 30rpx 30rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 4rpx 12rpx rgba(0,0,0,.1)}.app-title{font-size:48rpx;font-weight:700;color:#fff;text-shadow:0 2rpx 4rpx rgba(0,0,0,.2)}.blank-area{flex:1;padding:40rpx 30rpx;display:flex;align-items:center;justify-content:center}.blank-content{text-align:center;background-color:#fff;padding:60rpx 40rpx;border-radius:20rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.15);max-width:500rpx}.blank-title{font-size:36rpx;font-weight:600;color:#333;display:block}.bottom-button{height:8vh;background:linear-gradient(135deg,#87ceeb,#b0e0e6);display:flex;align-items:center;justify-content:center;border-radius:20rpx 20rpx 0 0;box-shadow:0 -4rpx 12rpx rgba(0,0,0,.1);transition:all .3s ease}.bottom-button:active{background:linear-gradient(135deg,#7bc4e8,#a8d8e6);transform:translateY(2rpx)}.button-text{font-size:36rpx;font-weight:600;color:#fff;text-shadow:0 2rpx 4rpx rgba(0,0,0,.2)}
