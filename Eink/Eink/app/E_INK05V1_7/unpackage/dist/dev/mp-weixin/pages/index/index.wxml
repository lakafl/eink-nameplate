<view class="page-container"><view class="top-section"><text class="app-title">SWU电子座牌</text></view><view class="selection-area"><view class="selection-box"><text class="selection-label">墨水屏尺寸选择</text><view class="selection-content" bindtap="{{b}}"><text class="selection-text">{{a}}</text><text class="dropdown-arrow">▼</text></view><view wx:if="{{c}}" class="dropdown-options"><view class="option-item" bindtap="{{d}}"><text>4.2英寸三色墨水屏</text></view><view class="option-item" bindtap="{{e}}"><text>7.5英寸三色墨水屏</text></view></view></view><view class="selection-box"><text class="selection-label">蓝牙连接</text><view class="selection-content" bindtap="{{g}}"><text class="selection-text">{{f}}</text><text class="dropdown-arrow">▼</text></view><view wx:if="{{h}}" class="dropdown-options"><view wx:if="{{i}}" class="option-item" bindtap="{{j}}"><text>扫描设备</text></view><view wx:if="{{k}}" class="option-item" bindtap="{{l}}"><text class="retry-text">重新初始化蓝牙</text></view><view wx:if="{{m}}" class="option-item scanning-item"><view class="scanning-info"><view class="scanning-status"><text class="scanning-text">正在扫描</text><view class="scanning-dots"><text class="dot">.</text><text class="dot">.</text><text class="dot">.</text></view></view></view><view class="stop-scan-btn" bindtap="{{n}}"><text class="stop-scan-text">停止</text></view></view><scroll-view wx:if="{{o}}" class="device-list-scroll" scroll-y="true"><view wx:for="{{p}}" wx:for-item="device" wx:key="e" class="option-item device-item" bindtap="{{device.f}}"><view class="device-info"><text class="device-name">{{device.a}}</text><text class="device-id">{{device.b}}</text></view><view class="device-signal"><text class="device-rssi">{{device.c}}dBm</text><view class="{{['signal-bar', device.d]}}"></view></view></view></scroll-view><view wx:if="{{q}}" class="option-item" bindtap="{{r}}"><text>断开连接</text></view><view wx:if="{{s}}" class="option-item" bindtap="{{t}}"><text>发现服务</text></view></view></view></view><view class="bottom-button" bindtap="{{v}}"><text class="button-text">模板选择</text></view></view>